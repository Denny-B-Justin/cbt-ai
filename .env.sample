# AI settings. Set these in Posit Connect: Settings -> Runtime -> Environment Variables.
# The AI only works when the app runs on Posit Connect; it does not work on a local machine.

# Gateway URL (keep the "/" at the end)
MAI_BASE_URL=
# mAI endpoint of the model provider (OpenAI, Claude or Gemini)
MAI_ENDPOINT=
# Optional. Model name, e.g. gpt-6-luna, claude-haiku-5-5 or gemini-3.8-flash. Must match MAI_ENDPOINT's provider.
MAI_MODEL=

# ── Optional app settings (defaults shown) ──────────────────────────────────
# AI_REQUESTS_PER_MINUTE=3500
# AI_TOKENS_PER_MINUTE=35000
# AI_PARALLEL_CALLS=3
# MAX_UPLOAD_MB=50
# SESSION_IDLE_MINUTES=15
# MAX_RUNNING_ANALYSES=8
# PORT=8050
# LOG_LEVEL=INFO
