# Copy this file to .env and fill in GEMINI_API_KEY. The .env file is never committed.

# ── Required ────────────────────────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Model used for reading, tagging and scoring. Use a "flash" model for the free tier.
# Run `python tests/live_check.py` to confirm that the key and the model work.
GEMINI_MODEL=gemini-3.6-flash

# Free-tier limits are low. These keep the app inside them (raise them on a paid key).
AI_REQUESTS_PER_MINUTE=8
AI_PARALLEL_CALLS=3

# Largest upload in MB, and minutes of silence after which a visitor's data is dropped.
MAX_UPLOAD_MB=50
SESSION_IDLE_MINUTES=15
MAX_RUNNING_ANALYSES=8

# Port for `python app.py`
PORT=8050

# AI provider module in ai/: gemini | mai-chatgpt | mai-claude
AI_PROVIDER=gemini

# ── mAI (World Bank gateway) — needed only when AI_PROVIDER is mai-chatgpt or mai-claude ──
# Azure service principal used to get the gateway's bearer token
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Token scope for the gateway (the DEFAULT_TOKEN_KEY value from the mAI docs)
MAI_TOKEN_SCOPE=
# Gateway base URL (BASE_URL_MAI from the mAI docs) and your team name (sent as x-team-name)
MAI_BASE_URL=
MAI_TEAM_NAME=
# Bedrock base URL for Claude (mai-claude). Calls go to <this>/model/<MAI_LLM>/converse.
MAI_CLAUDE_BASE_URL=https://azapimdev.worldbank.org/conversationalai/bedrock
# Model the mAI provider uses. Set by the developer only; the app does not let visitors change it.
# Leave empty for the default: gpt-5.6-luna (mai-chatgpt) or
# us.anthropic.claude-sonnet-4-5-20250929-v1:0 (mai-claude, a Bedrock model id).
MAI_LLM=

# Advanced, usually left empty
# GEMINI_THINKING_LEVEL=low        # minimal | low | medium | high | off
# GEMINI_BASE_URL=                 # only for a proxy or a test server
# LOG_LEVEL=INFO
