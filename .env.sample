# AI settings. Set these in Posit Connect: Settings -> Runtime -> Environment Variables.
# The AI only works when the app runs on Posit Connect; it does not work on a local machine.# No keys, tokens or model names: people choose the model in the app (the list is in constants.py, MODELS).
# Posit Connect sets CONNECT_CONTENT_GUID itself; do not add it.

# Gateway URL (keep the "/" at the end)
MAI_BASE_URL=

MAI_OPENAI_ENDPOINT=
MAI_GEMINI_ENDPOINT=
MAI_CLAUDE_ENDPOINT=

# ── Optional app settings (defaults shown) ──────────────────────────────────
# Per model: each model has its own budget of requests and tokens per minute.
─────────
# AI_REQUESTS_PER_MINUTE=3500
# AI_TOKENS_PER_MINUTE=35000
# AI_PARALLEL_CALLS=3
# MAX_UPLOAD_MB=50
# SESSION_IDLE_MINUTES=15
# MAX_RUNNING_ANALYSES=8
# PORT=8050
# LOG_LEVEL=INFO
