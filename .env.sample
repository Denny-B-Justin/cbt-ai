# Copy this file to .env and fill in GEMINI_API_KEY. The .env file is never committed.

# ── Required ────────────────────────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Model used for reading, tagging and scoring. Use a "flash" model for the free tier.
# Run `python tests/live_check.py` to confirm that the key and the model work.
GEMINI_MODEL=gemini-3.6-flash

# Free-tier limits are low. These keep the app inside them (raise them on a paid key).
AI_REQUESTS_PER_MINUTE=8
AI_PARALLEL_CALLS=3

# Largest upload in MB, and minutes of silence after which a visitor's data is dropped.
MAX_UPLOAD_MB=50
SESSION_IDLE_MINUTES=15
MAX_RUNNING_ANALYSES=8

# Port for `python app.py`
PORT=8050

# AI provider module in ai/ (gemini today; add ai/claude.py and set AI_PROVIDER=claude)
AI_PROVIDER=gemini

# Advanced, usually left empty
# GEMINI_THINKING_LEVEL=low        # minimal | low | medium | high | off
# GEMINI_BASE_URL=                 # only for a proxy or a test server
# LOG_LEVEL=INFO
