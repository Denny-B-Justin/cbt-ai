# Copy this file to .env (it is git-ignored) and fill in what you have, or set the same variables in your host's
# environment settings. The app reads .env when it starts.

# ── AI provider keys ────────────────────────────────────────────────────────
# Set the key of at least one provider; leave the others empty. The model picker then offers only the models of the
# providers you gave a key for (four each: three latest and one older; the list is MODELS in constants.py).
#   OpenAI     https://platform.openai.com/api-keys
#   Anthropic  https://console.anthropic.com/settings/keys
#   Gemini     https://aistudio.google.com/apikey        (GOOGLE_API_KEY is read too)
#   Mistral    https://console.mistral.ai/api-keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Optional: send a provider's calls to another address, e.g. a company proxy (OpenAI's must end in /v1).
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
# MISTRAL_BASE_URL=

# ── Optional app settings (defaults shown) ──────────────────────────────────
# Pacing, per model. Set them to your account's limits: they differ by provider and by account tier.
# AI_REQUESTS_PER_MINUTE=50
# AI_TOKENS_PER_MINUTE=0          (0 = no token budget; refused calls are still waited out and retried)
# AI_PARALLEL_CALLS=3
# MAX_UPLOAD_MB=50
# SESSION_IDLE_MINUTES=15
# MAX_RUNNING_ANALYSES=8
# PORT=8050
# LOG_LEVEL=INFO
